generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

enum CardType {
  VIATIC
  FUEL
}

enum FuelCardStatus {
  active
  inactive
  blocked
  cancelled
}

enum FuelAssignmentType {
  NotAcumulative
  Acumulable
}

enum FuelCardKind {
  physical
  virtual
}

datasource db {
  provider = "mysql"
}

model Company {
  id    Int    @id @default(autoincrement())
  name  String
  users User[]
  cards Card[]
}

model Area {
  id    Int    @id @default(autoincrement())
  name  String
  users User[]
}

model Branch {
  id    Int    @id @default(autoincrement())
  name  String
  users User[]
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String
  users User[]
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companyId Int
  branchId  Int
  areaId    Int
  roleId    Int
  cardId    Int?
  isActive  Boolean  @default(true)

  managerId Int?
  manager   User?  @relation("UserManager", fields: [managerId], references: [id])
  reports   User[] @relation("UserManager")

  company Company @relation(fields: [companyId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])
  area    Area    @relation(fields: [areaId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])
  cards   Card[]
}

model Card {
  id                 Int                 @id @default(autoincrement())
  cardNumber         String              @unique
  type               CardType
  companyId          Int?
  company            Company?            @relation(fields: [companyId], references: [id])
  // uso viáticos
  userId             Int?
  user               User?               @relation(fields: [userId], references: [id])
  isActive           Boolean             @default(true)
  assignedAt         DateTime            @default(now())
  limite             Decimal?            @db.Decimal(12, 2)
  // uso gasolina
  fuelName           String?
  fuelCardKind       FuelCardKind?
  fuelGroup          String?
  fuelAssignmentType FuelAssignmentType?
  fuelStatus         FuelCardStatus?
  sapCode            String?
  sapSyncedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([type])
  @@index([companyId])
  @@index([userId])
}
