generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

enum CardType {
  VIATIC
  FUEL
}

enum FuelCardStatus {
  active
  inactive
  blocked
  cancelled
}

enum FuelAssignmentType {
  NotAcumulative
  Acumulable
}

enum FuelCardKind {
  physical
  virtual
}

enum BranchSource {
  INTERNAL
  SAP_ALIANZA
}

enum TravelRequestReconciliationStatus {
  pending
  rejected
  approved
  verified
}

enum TripMovementProofType {
  ticket
  invoice
}

enum TripMovementProofStatus {
  submitted
  approved
  rejected
}

enum TripMovementFileRole {
  ticket
  invoice_xml
  invoice_pdf
  invoice_xml_outbound
  invoice_pdf_outbound
  invoice_xml_return
  invoice_pdf_return
}

enum TripMovementProofCfdiXmlFileRole {
  invoice_xml
  invoice_xml_outbound
  invoice_xml_return
}

enum GasolineRequestStatus {
  pending
  approved
  rejected
  dispersed
}

enum GasolineNotificationRecipientRole {
  treasury_approver
  dispersal_notify
}

enum TravelRequestTripTagDispersionStatus {
  pending
  dispersed
}

datasource db {
  provider = "mysql"
}

model Company {
  id                Int                @id @default(autoincrement())
  name              String
  users             User[]
  cards             Card[]
  travelRequests    TravelRequest[]
  branches          Branch[]
  gasolineSuppliers GasolineSupplier[]
  accountCodes      AccountCode[]
  distributionRules DistributionRule[]
  vats              VAT[]
  viaticCategories  ViaticCategory[]
  currencies        Currency[]
  gasolineRequests  GasolineRequest[]
}

model Area {
  id                Int                @id @default(autoincrement())
  name              String
  users             User[]
  travelRequests    TravelRequest[]
  distributionRules DistributionRule[]
  gasolineRequests  GasolineRequest[]
}

model Branch {
  id               Int               @id @default(autoincrement())
  name             String
  companyId        Int?
  company          Company?          @relation(fields: [companyId], references: [id])
  externalCode     String?
  source           BranchSource?
  users            User[]
  travelRequests   TravelRequest[]
  gasolineRequests GasolineRequest[]

  @@unique([companyId, externalCode])
  @@index([companyId])
}

model Role {
  id                     Int                     @id @default(autoincrement())
  name                   String
  users                  User[]
  roleDefaultPermissions RoleDefaultPermission[]
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companyId Int
  branchId  Int
  areaId    Int
  roleId    Int
  isActive  Boolean  @default(true)

  managerId Int?
  manager   User?  @relation("UserManager", fields: [managerId], references: [id])
  reports   User[] @relation("UserManager")

  travelRequests            TravelRequest[]     @relation("TravelRequestUser")
  approvedTravelRequests    TravelRequest[]     @relation("TravelRequestApprover")
  tripsApprovedAsAuthorizer TravelRequestTrip[] @relation("TravelRequestTripApprovedBy")
  travelRequestsDispersed   TravelRequest[]     @relation("TravelRequestDispersedBy")

  company                        Company                         @relation(fields: [companyId], references: [id])
  branch                         Branch                          @relation(fields: [branchId], references: [id])
  area                           Area                            @relation(fields: [areaId], references: [id])
  role                           Role                            @relation(fields: [roleId], references: [id])
  cards                          Card[]
  createdCards                   Card[]                          @relation("CardCreatedByUser")
  assignedCards                  Card[]                          @relation("CardAssignedByUser")
  deactivatedCards               Card[]                          @relation("CardDeactivatedByUser")
  requestedReconciliations       TravelRequestReconciliation[]   @relation("TravelRequestReconciliationRequestedBy")
  decidedReconciliations         TravelRequestReconciliation[]   @relation("TravelRequestReconciliationDecidedBy")
  movementProofs                 TripMovementProof[]
  userExtraPermissions           UserExtraPermission[]
  gasolineRequests               GasolineRequest[]               @relation("GasolineRequestUser")
  approvedGasolineRequests       GasolineRequest[]               @relation("GasolineRequestApprover")
  dispersedGasolineRequests      GasolineRequest[]               @relation("GasolineRequestDisbursed")
  gasolineNotificationRecipients GasolineNotificationRecipient[]
}

model Card {
  id                         Int                         @id @default(autoincrement())
  cardNumber                 String                      @unique
  type                       CardType
  companyId                  Int?
  company                    Company?                    @relation(fields: [companyId], references: [id])
  // uso viáticos
  userId                     Int?
  user                       User?                       @relation(fields: [userId], references: [id])
  isActive                   Boolean                     @default(true)
  assignedAt                 DateTime                    @default(now())
  limite                     Decimal?                    @db.Decimal(12, 2)
  // uso gasolina
  fuelName                   String?
  fuelCardKind               FuelCardKind?
  fuelGroup                  String?
  fuelAssignmentType         FuelAssignmentType?
  fuelStatus                 FuelCardStatus?
  sapCode                    String?
  sapSyncedAt                DateTime?
  createdById                Int?
  createdBy                  User?                       @relation("CardCreatedByUser", fields: [createdById], references: [id])
  assignedById               Int?
  assignedBy                 User?                       @relation("CardAssignedByUser", fields: [assignedById], references: [id])
  deactivatedAt              DateTime?
  deactivatedById            Int?
  deactivatedBy              User?                       @relation("CardDeactivatedByUser", fields: [deactivatedById], references: [id])
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  travelRequestTripGasolines TravelRequestTripGasoline[]
  gasolineRequests           GasolineRequest[]

  @@index([type])
  @@index([companyId])
  @@index([userId])
  @@index([createdById])
  @@index([assignedById])
  @@index([deactivatedById])
}

enum TravelRequestStatus {
  draft
  submitted
  awaiting_trip_correction
  approved
  rejected
  dispersed
  cancelled
}

enum TravelRequestTripApprovalStatus {
  pending
  approved
  rejected
  dispersed
}

model TravelRequest {
  id                  Int                 @id @default(autoincrement())
  userId              Int
  companyId           Int
  branchId            Int
  areaId              Int
  approverId          Int?
  employeeName        String
  corporateCardNumber String?
  status              TravelRequestStatus @default(draft)
  approverComment     String?             @db.Text
  submittedAt         DateTime?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  dispersedAt         DateTime?
  dispersedTotal      Decimal?            @db.Decimal(12, 2)
  dispersionComment   String?             @db.Text
  dispersedById       Int?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user            User                          @relation("TravelRequestUser", fields: [userId], references: [id])
  company         Company                       @relation(fields: [companyId], references: [id])
  branch          Branch                        @relation(fields: [branchId], references: [id])
  area            Area                          @relation(fields: [areaId], references: [id])
  approver        User?                         @relation("TravelRequestApprover", fields: [approverId], references: [id])
  dispersedBy     User?                         @relation("TravelRequestDispersedBy", fields: [dispersedById], references: [id])
  trips           TravelRequestTrip[]
  reconciliations TravelRequestReconciliation[]

  @@index([userId])
  @@index([companyId])
  @@index([branchId])
  @@index([areaId])
  @@index([approverId])
  @@index([dispersedById])
  @@index([status])
  @@index([createdAt])
}

model TravelRequestTrip {
  id                 Int                             @id @default(autoincrement())
  travelRequestId    Int
  tripOrder          Int
  destination        String
  purpose            String                          @db.Text
  departureDate      DateTime
  returnDate         DateTime
  disbursementDate   DateTime
  estimatedTotal     Decimal                         @default(0) @db.Decimal(12, 2)
  tripApprovalStatus TravelRequestTripApprovalStatus @default(pending)
  approvedAt         DateTime?
  rejectedAt         DateTime?
  approverComment    String?                         @db.Text
  approvedById       Int?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt

  travelRequest      TravelRequest                @relation(fields: [travelRequestId], references: [id])
  approvedBy         User?                        @relation("TravelRequestTripApprovedBy", fields: [approvedById], references: [id])
  objectives         TravelRequestTripObjective[]
  expenses           TravelRequestTripExpense?
  gasoline           TravelRequestTripGasoline?
  tag                TravelRequestTripTag?
  gasolineRequest    GasolineRequest?
  files              TravelRequestTripFile[]
  tripMovementProofs TripMovementProof[]

  @@unique([travelRequestId, tripOrder])
  @@index([travelRequestId])
  @@index([tripApprovalStatus])
  @@index([travelRequestId, tripApprovalStatus])
  @@index([approvedById])
}

model TravelRequestTripObjective {
  id             Int    @id @default(autoincrement())
  tripId         Int
  objectiveOrder Int
  description    String @db.Text

  trip TravelRequestTrip @relation(fields: [tripId], references: [id])

  @@unique([tripId, objectiveOrder])
  @@index([tripId])
}

model TravelRequestTripExpense {
  id            Int     @id @default(autoincrement())
  tripId        Int     @unique
  transport     Decimal @default(0) @db.Decimal(12, 2)
  tolls         Decimal @default(0) @db.Decimal(12, 2)
  lodging       Decimal @default(0) @db.Decimal(12, 2)
  food          Decimal @default(0) @db.Decimal(12, 2)
  freight       Decimal @default(0) @db.Decimal(12, 2)
  tools         Decimal @default(0) @db.Decimal(12, 2)
  shipping      Decimal @default(0) @db.Decimal(12, 2)
  miscellaneous Decimal @default(0) @db.Decimal(12, 2)

  trip TravelRequestTrip @relation(fields: [tripId], references: [id])

  @@index([tripId])
}

model TravelRequestTripGasoline {
  id               Int      @id @default(autoincrement())
  tripId           Int      @unique
  requiresGasoline Boolean  @default(false)
  cardId           Int?
  plate            String?
  currentMileageKm Decimal? @db.Decimal(12, 2)
  requestedAmount  Decimal? @db.Decimal(12, 2)
  distanceKm       Decimal? @db.Decimal(12, 2)
  comments         String?  @db.Text
  odometerPhoto    Bytes?

  trip TravelRequestTrip @relation(fields: [tripId], references: [id])
  card Card?             @relation(fields: [cardId], references: [id])

  @@index([tripId])
  @@index([cardId])
}

model TravelRequestTripTag {
  id                Int                                  @id @default(autoincrement())
  tripId            Int                                  @unique
  requiresTag       Boolean                              @default(false)
  requestedAmount   Decimal?                             @db.Decimal(12, 2)
  comments          String?                              @db.Text
  dispersionStatus  TravelRequestTripTagDispersionStatus @default(pending)

  trip TravelRequestTrip @relation(fields: [tripId], references: [id])

  @@index([tripId])
  @@index([dispersionStatus])
}

model TravelRequestTripFile {
  id                  Int                   @id @default(autoincrement())
  tripId              Int
  tripMovementProofId Int?
  fileType            String
  fileRole            TripMovementFileRole?
  fileUrl             String
  fileName            String?
  mimeType            String?
  createdAt           DateTime              @default(now())

  trip                   TravelRequestTrip       @relation(fields: [tripId], references: [id])
  tripMovementProof      TripMovementProof?      @relation(fields: [tripMovementProofId], references: [id], onDelete: SetNull)
  tripMovementProofCfdis TripMovementProofCfdi[]

  @@index([tripId])
  @@index([tripMovementProofId])
  @@index([fileRole])
}

model GasolineSupplier {
  id        Int      @id @default(autoincrement())
  code      String
  name      String
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([companyId])
}

model AccountCode {
  id        Int     @id @default(autoincrement())
  code      String
  name      String
  isActive  Boolean @default(true)
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([companyId])
}

model TravelRequestReconciliation {
  id                   Int                               @id @default(autoincrement())
  travelRequestId      Int
  requestedByUserId    Int
  status               TravelRequestReconciliationStatus @default(pending)
  verificationCodeHash String                            @db.VarChar(255)
  codeExpiresAt        DateTime
  decidedByUserId      Int?
  decidedAt            DateTime?
  rejectionReason      String?                           @db.Text
  codeVerifiedAt       DateTime?
  createdAt            DateTime                          @default(now())
  updatedAt            DateTime                          @updatedAt
  travelRequest        TravelRequest                     @relation(fields: [travelRequestId], references: [id], onDelete: Cascade)
  requestedBy          User                              @relation("TravelRequestReconciliationRequestedBy", fields: [requestedByUserId], references: [id])
  decidedBy            User?                             @relation("TravelRequestReconciliationDecidedBy", fields: [decidedByUserId], references: [id])

  @@index([travelRequestId])
  @@index([status])
  @@index([createdAt])
  @@index([decidedAt])
  @@index([requestedByUserId])
}

model TripMovementProof {
  id                      Int                     @id @default(autoincrement())
  tripId                  Int
  movementSequence        Int
  movementDate            DateTime
  movementAmount          Decimal                 @db.Decimal(12, 2)
  movementMemo            String?                 @db.Text
  proofType               TripMovementProofType
  status                  TripMovementProofStatus @default(submitted)
  comment                 String?                 @db.Text
  createdByUserId         Int
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  cfdiPdfCrosscheckPassed Boolean?
  cfdiPdfCrosscheckAt     DateTime?

  trip          TravelRequestTrip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdByUser User                    @relation(fields: [createdByUserId], references: [id])
  files         TravelRequestTripFile[]
  cfdiRecords   TripMovementProofCfdi[]

  @@unique([tripId, movementSequence])
  @@index([tripId])
  @@index([createdByUserId])
  @@index([status])
  @@index([createdAt])
}

model TripMovementProofCfdi {
  id                  Int                              @id @default(autoincrement())
  tripMovementProofId Int
  tripFileId          Int?
  cfdiUuid            String                           @db.VarChar(36)
  fechaEmision        DateTime
  xmlFileRole         TripMovementProofCfdiXmlFileRole
  createdAt           DateTime                         @default(now())

  tripMovementProof TripMovementProof      @relation(fields: [tripMovementProofId], references: [id], onDelete: Cascade)
  tripFile          TravelRequestTripFile? @relation(fields: [tripFileId], references: [id], onDelete: SetNull)

  @@unique([cfdiUuid])
  @@index([tripMovementProofId])
  @@index([tripFileId])
  @@index([fechaEmision])
}

model DistributionRule {
  id        Int    @id @default(autoincrement())
  code      String
  name      String
  companyId Int
  areaId    Int?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  area    Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@unique([companyId, areaId, code])
  @@index([companyId])
  @@index([companyId, areaId])
}

model VAT {
  id        Int     @id @default(autoincrement())
  name      String
  code      String
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([companyId])
}

model ViaticCategory {
  id        Int     @id @default(autoincrement())
  name      String
  code      String
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([companyId])
}

model RoleDefaultPermission {
  id             Int    @id @default(autoincrement())
  roleId         Int
  permissionCode String @db.VarChar(64)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionCode])
  @@index([permissionCode])
}

model UserExtraPermission {
  id             Int    @id @default(autoincrement())
  userId         Int
  permissionCode String @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionCode])
  @@index([permissionCode])
}

model Currency {
  id              Int     @id @default(autoincrement())
  name            String
  sapCurrencyCode String
  companyId       Int
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@unique([companyId, sapCurrencyCode])
  @@index([companyId])
}

model GasolineRequest {
  id                Int                   @id @default(autoincrement())
  userId            Int
  companyId         Int
  branchId          Int?
  areaId            Int?
  cardId            Int
  plate             String
  currentMileageKm  Decimal               @db.Decimal(12, 2)
  requestedAmount   Decimal               @db.Decimal(12, 2)
  distanceKm        Decimal               @db.Decimal(12, 2)
  routeToTake       String
  applicantComments String?               @db.Text
  status            GasolineRequestStatus @default(pending)
  approverId        Int?
  approverComment   String?               @db.Text
  approvedAt        DateTime?
  disbursedById     Int?
  disbursedComment  String?               @db.Text
  disbursedAt       DateTime?
  travelRequestTripId Int?                @unique
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  user              User                           @relation("GasolineRequestUser", fields: [userId], references: [id])
  company           Company                        @relation(fields: [companyId], references: [id])
  branch            Branch?                        @relation(fields: [branchId], references: [id])
  area              Area?                          @relation(fields: [areaId], references: [id])
  card              Card                           @relation(fields: [cardId], references: [id])
  approver          User?                          @relation("GasolineRequestApprover", fields: [approverId], references: [id])
  disbursedBy       User?                          @relation("GasolineRequestDisbursed", fields: [disbursedById], references: [id])
  travelRequestTrip TravelRequestTrip?             @relation(fields: [travelRequestTripId], references: [id])
  odometerPhotos    GasolineRequestOdometerPhoto[]

  @@index([userId])
  @@index([companyId])
  @@index([branchId])
  @@index([areaId])
  @@index([cardId])
  @@index([approverId])
  @@index([disbursedById])
  @@index([status])
}

model GasolineRequestOdometerPhoto {
  id                Int             @id @default(autoincrement())
  gasolineRequestId Int
  photo             Bytes
  gasolineRequest   GasolineRequest @relation(fields: [gasolineRequestId], references: [id], onDelete: Cascade)

  @@index([gasolineRequestId])
}

model GasolineNotificationRecipient {
  id        Int                               @id @default(autoincrement())
  userId    Int
  role      GasolineNotificationRecipientRole
  isActive  Boolean                           @default(true)
  createdAt DateTime                          @default(now())
  updatedAt DateTime                          @updatedAt
  user      User                              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role, isActive])
}
