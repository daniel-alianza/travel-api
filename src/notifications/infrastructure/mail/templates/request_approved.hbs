<!DOCTYPE html>
<html lang="es" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light only" />
  <meta name="supported-color-schemes" content="light" />
  <title>Solicitud de viáticos aprobada</title>
  <!--[if mso]>
  <style type="text/css">
    body, table, td { font-family: Arial, Helvetica, sans-serif !important; }
  </style>
  <![endif]-->
</head>
<body bgcolor="#eef1f5" style="margin:0;padding:0;background-color:#eef1f5;font-family:Arial,Helvetica,sans-serif;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#eef1f5" style="background-color:#eef1f5;margin:0;padding:0;">
    <tr>
      <td align="center" bgcolor="#eef1f5" style="padding:36px 16px;background-color:#eef1f5;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="max-width:600px;width:100%;background-color:#ffffff;border:1px solid #dde3ea;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(17,24,39,0.08);">

          <tr>
            <td height="5" bgcolor="{{brandColorPrimary}}" style="height:5px;line-height:5px;font-size:0;background-color:{{brandColorPrimary}};">&nbsp;</td>
          </tr>

          <tr>
            <td bgcolor="#ffffff" style="padding:28px 32px 20px;background-color:#ffffff;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="background-color:#ffffff;">
                <tr>
                  <td align="left" valign="middle" bgcolor="#ffffff" style="background-color:#ffffff;">
                    <img src="{{logoUrl}}" alt="{{companyName}}" width="{{logoWidth}}" style="display:block;border:0;outline:none;text-decoration:none;max-width:{{logoWidth}}px;height:auto;" />
                  </td>
                  <td align="right" valign="middle" bgcolor="#ffffff" style="background-color:#ffffff;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td bgcolor="#f0fdf4" style="padding:8px 14px;border-radius:20px;background-color:#f0fdf4;border:1px solid #bbf7d0;">
                          <span style="font-size:12px;font-weight:700;color:#166534;letter-spacing:0.3px;">&#10004;&#65039; Aprobada</span>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td bgcolor="#ffffff" style="padding:0 32px 8px;background-color:#ffffff;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f0fdf4" style="background-color:#f0fdf4;border:1px solid #bbf7d0;border-radius:12px;">
                <tr>
                  <td bgcolor="#f0fdf4" style="padding:18px 20px;background-color:#f0fdf4;">
                    <p style="margin:0 0 6px 0;font-size:26px;line-height:1;background-color:#f0fdf4;">&#127881;</p>
                    <h1 style="margin:0 0 8px 0;font-size:21px;font-weight:700;line-height:1.35;color:#166534;background-color:#f0fdf4;">
                      &#9992;&#65039; Solicitud aprobada
                    </h1>
                    <p style="margin:0;font-size:15px;line-height:1.6;color:#15803d;background-color:#f0fdf4;">
                      Hola <strong style="color:#166534;">{{employeeName}}</strong>, tu solicitud de vi&aacute;ticos ha sido <strong style="color:#166534;">aprobada</strong> por <strong style="color:#166534;">{{bossName}}</strong> y est&aacute; lista para seguir el proceso de dispersi&oacute;n.
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td bgcolor="#ffffff" style="padding:20px 32px 0;background-color:#ffffff;">
              <p style="margin:0 0 10px 0;font-size:13px;font-weight:700;letter-spacing:0.6px;text-transform:uppercase;color:{{brandColorSecondary}};background-color:#ffffff;">
                &#128203; Resumen de tu solicitud
              </p>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="background-color:#ffffff;border:1px solid #e5e7eb;border-left:5px solid {{brandColorPrimary}};border-radius:10px;">
                <tr>
                  <td bgcolor="#ffffff" style="padding:6px 20px 14px;background-color:#ffffff;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="background-color:#ffffff;">

                      <tr>
                        <td colspan="2" bgcolor="#ffffff" style="padding:12px 0 8px;font-size:12px;font-weight:700;color:{{brandColorPrimary}};text-transform:uppercase;letter-spacing:0.4px;background-color:#ffffff;border-bottom:1px solid #f0f2f5;">
                          Detalle del viaje
                        </td>
                      </tr>

                      <tr>
                        <td bgcolor="#ffffff" style="padding:14px 0 10px;font-size:14px;color:{{brandColorSecondary}};width:40%;vertical-align:top;background-color:#ffffff;">&#128221; Motivo</td>
                        <td bgcolor="#ffffff" style="padding:14px 0 10px;font-size:14px;font-weight:600;color:#111827;width:60%;vertical-align:top;background-color:#ffffff;">{{motivo}}</td>
                      </tr>
                      <tr>
                        <td bgcolor="#ffffff" style="padding:0 0 10px;font-size:14px;color:{{brandColorSecondary}};vertical-align:top;background-color:#ffffff;">&#128205; Destinos</td>
                        <td bgcolor="#ffffff" style="padding:0 0 10px;font-size:14px;font-weight:600;color:#111827;vertical-align:top;background-color:#ffffff;">{{destinos}}</td>
                      </tr>
                      <tr>
                        <td bgcolor="#ffffff" style="padding:0 0 10px;font-size:14px;color:{{brandColorSecondary}};vertical-align:top;background-color:#ffffff;">&#127890; Viajes</td>
                        <td bgcolor="#ffffff" style="padding:0 0 10px;font-size:14px;font-weight:600;color:#111827;vertical-align:top;background-color:#ffffff;">{{tripCount}}</td>
                      </tr>

                      <tr>
                        <td colspan="2" bgcolor="#ffffff" style="padding:8px 0;background-color:#ffffff;">
                          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f8fafc" style="background-color:#f8fafc;border-radius:8px;">
                            <tr>
                              <td bgcolor="#f8fafc" style="padding:14px 16px;background-color:#f8fafc;">
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f8fafc" style="background-color:#f8fafc;">
                                  <tr>
                                    <td bgcolor="#f8fafc" style="font-size:14px;color:{{brandColorSecondary}};background-color:#f8fafc;">&#128176; Total estimado</td>
                                    <td align="right" bgcolor="#f8fafc" style="font-size:20px;font-weight:800;color:{{brandColorPrimary}};background-color:#f8fafc;">${{formatCurrency totalAmount}}</td>
                                  </tr>
                                </table>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>

                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          {{#if gasolinaAmount}}
          <tr>
            <td bgcolor="#ffffff" style="padding:14px 32px 0;background-color:#ffffff;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#fffbeb" style="background-color:#fffbeb;border:1px solid #fde68a;border-radius:10px;">
                <tr>
                  <td bgcolor="#fffbeb" style="padding:13px 16px;font-size:14px;line-height:1.5;color:#92400e;background-color:#fffbeb;">
                    <strong style="color:#78350f;">&#9981; Gasolina:</strong> ${{formatCurrency gasolinaAmount}}
                    {{#if cardNumber}} &mdash; Tarjeta: {{cardNumber}}{{/if}}
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {{/if}}

          {{#if tagAmount}}
          <tr>
            <td bgcolor="#ffffff" style="padding:14px 32px 0;background-color:#ffffff;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#eff6ff" style="background-color:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;">
                <tr>
                  <td bgcolor="#eff6ff" style="padding:13px 16px;font-size:14px;line-height:1.5;color:#1e40af;background-color:#eff6ff;">
                    <strong style="color:#1e3a8a;">&#127991; TAG:</strong> ${{formatCurrency tagAmount}}
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {{/if}}

          <tr>
            <td align="center" bgcolor="#ffffff" style="padding:28px 32px 10px;background-color:#ffffff;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center" bgcolor="{{brandColorPrimary}}" style="border-radius:8px;background-color:{{brandColorPrimary}};">
                    <a href="{{appUrl}}" target="_blank" style="display:inline-block;padding:14px 32px;font-size:15px;font-weight:700;line-height:1;color:{{brandButtonTextColor}};text-decoration:none;background-color:{{brandColorPrimary}};border-radius:8px;">
                      &#128640; Ir a la aplicaci&oacute;n
                    </a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td bgcolor="#ffffff" style="padding:8px 32px 28px;font-size:12px;line-height:1.6;color:#9ca3af;text-align:center;background-color:#ffffff;">
              <p style="margin:0;background-color:#ffffff;color:#9ca3af;">
                &#128232; Este es un mensaje autom&aacute;tico, por favor no respondas a este correo.
              </p>
            </td>
          </tr>

        </table>

        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;">
          <tr>
            <td align="center" style="padding:16px 8px 0;font-size:11px;color:#9ca3af;">
              &copy; {{companyName}} &mdash; Grupo FG
            </td>
          </tr>
        </table>

      </td>
    </tr>
  </table>
</body>
</html>
